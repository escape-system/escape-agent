{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash#max",
  "small_model": "opencode-go/deepseek-v4.1-flash",
  "subagents": {
    "default_model": "opencode-go/deepseek-v4.1-flash#max",
    "digest_model": "opencode-go/deepseek-v4.1-flash",
    "timeout_seconds": 3600,
    "max_children_per_session": 64,
    "agents": {
      "steward": {
        "role": "coordinator"
      }
    }
  },
  "observer": {
    "model": "opencode-go/deepseek-v4.1-flash",
    "digest_model": "opencode-go/deepseek-v4.1-flash",
    "nudge_max_chars": 600
  },
  "agents": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash#max"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4.1-flash#max"
    },
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash#max"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash#max"
    },
    "steward": {
      "mode": "subagent",
      "description": "Build steward: single owner of the cargo lane. Runs the classified cargo queue for other agents, returns results, and never edits code.",
      "steps": 120,
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "subagent",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "lane",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "grep",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "glob",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "box:read",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "box:write",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "talk",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "roster",
          "resource": "*",
          "effect": "allow"
        },
        {
          "action": "digest",
          "resource": "*",
          "effect": "allow"
        }
      ]
    }
  }
}
