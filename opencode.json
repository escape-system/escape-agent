{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash#max",
  "small_model": "opencode-go/deepseek-v4.1-flash#max",
  "providers": {
    "experiential": {
      "name": "Experiential Labs",
      "package": "@ai-sdk/openai-compatible",
      "env": ["EXPLABS_API_KEY"],
      "settings": {
        "baseURL": "https://api.experientiallabs.ai/v1"
      },
      "models": {
        "deepseek-v4.1-flash-1017": {
          "name": "DeepSeek V4.1 Flash 1017",
          "modelID": "deepseek-v4.1-flash-1017",
          "package": "@ai-sdk/openai-compatible",
          "settings": {
            "baseURL": "https://api.experientiallabs.ai/v1"
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "max"]
            }
          },
          "limit": {
            "context": 1048576
          }
        },
        "claude-sonnet-5.5": {
          "name": "Claude Sonnet 5.5",
          "modelID": "claude-sonnet-5.5",
          "package": "@ai-sdk/openai-compatible",
          "settings": {
            "baseURL": "https://api.experientiallabs.ai/v1"
          },
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
            "reasoning": {
              "supported": true,
              "effort": ["low", "medium", "high", "xhigh", "max"]
            }
          }
        }
      }
    }
  },
  "subagents": {
    "default_model": "opencode-go/deepseek-v4.1-flash#max",
    "timeout_seconds": 3600,
    "max_children_per_session": 64
  },
  "observer": {
    "model": "opencode-go/deepseek-v4.1-flash#max",
    "nudge_max_chars": 600
  },
  "agents": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash#max"
    },
    "plan": {
      "model": "opencode-go/deepseek-v4.1-flash#max"
    },
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash#max"
    },
    "explore": {
      "model": "opencode-go/deepseek-v4.1-flash#max"
    },
    "steward": {
      "mode": "subagent",
      "description": "Build steward: single owner of the cargo lane. Runs the classified cargo queue for other agents, returns results, and never edits code.",
      "steps": 120,
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "shell", "resource": "*", "effect": "allow" },
        { "action": "lane", "resource": "*", "effect": "allow" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "box:read", "resource": "*", "effect": "allow" },
        { "action": "box:write", "resource": "*", "effect": "allow" },
        { "action": "talk", "resource": "*", "effect": "allow" },
        { "action": "roster", "resource": "*", "effect": "allow" },
        { "action": "digest", "resource": "*", "effect": "allow" }
      ]
    }
  }
}
