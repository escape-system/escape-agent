+
+  while (at !== -1) {
+    const start = map[at]
+    const last = map[at + needle.length - 1]
+
+    if (start !== undefined && last !== undefined) ranges.push({ start, end: last + 1 })
+    at = haystack.indexOf(needle, at + needle.length)
+  }
