diff -ruN a/packages/app/src/providers/models/picker-policy.test.ts b/packages/app/src/providers/models/picker-policy.test.ts
--- a/packages/app/src/providers/models/picker-policy.test.ts	1970-01-01 02:00:00.000000000 +0200
+++ b/packages/app/src/providers/models/picker-policy.test.ts	2026-11-15 16:30:35.062172756 +0300
@@ -0,0 +1,133 @@
+import { describe, expect, test } from "bun:test"
+import {
+  chainIndexOf,
+  comparePickerModels,
+  effectiveAgentChain,
+  favoriteRefs,
+  modelReference,
+  normalizeModelRef,
+  pickerVisible,
+  type PickerOrder,
+} from "./policy"
+
+const entry = (visible = true, favorite = false) => ({ visible, favorite })
+
+const ref = (providerID: string, id: string) => modelReference({ providerID, id })
+
+describe("references", () => {
+  test("drops a variant suffix, lowercases and folds dots", () => {
+    expect(normalizeModelRef("Anthropic/Claude.Sonnet-4#high")).toBe("anthropic/claude-sonnet-4")
+    expect(normalizeModelRef("  openai/gpt-5.6  ")).toBe("openai/gpt-5-6")
+    expect(normalizeModelRef("a/1")).toBe("a/1")
+  })
+
+  test("a #variant chain entry matches its base model", () => {
+    expect(chainIndexOf(["a/1#high"], ref("a", "1"))).toBe(0)
+    expect(chainIndexOf(["a/1"], ref("a", "1"))).toBe(0)
+    expect(chainIndexOf(["a/1"], ref("a", "2"))).toBe(-1)
+    expect(chainIndexOf([], ref("a", "1"))).toBe(-1)
+  })
+
+  test("an agent chain wins over the global one, and an empty one restricts nothing", () => {
+    expect(effectiveAgentChain({ build: ["a/1"] }, "build", ["b/2"])).toEqual(["a/1"])
+    expect(effectiveAgentChain({ build: [] }, "build", ["b/2"])).toEqual([])
+    expect(effectiveAgentChain({ build: ["a/1"] }, "plan", ["b/2"])).toEqual(["b/2"])
+    expect(effectiveAgentChain(undefined, "build", ["b/2"])).toEqual(["b/2"])
+  })
+})
+
+describe("picker visibility", () => {
+  test("without a registry the legacy store rule answers", () => {
+    expect(pickerVisible({ modelRef: "a/1", legacyVisible: true })).toBe(true)
+    expect(pickerVisible({ modelRef: "a/1", legacyVisible: false })).toBe(false)
+    expect(pickerVisible({ modelRef: "a/1" })).toBe(true)
+  })
+
+  test("every registry model the config does not hide is offered", () => {
+    expect(pickerVisible({ modelRef: "a/1", registryModel: entry() })).toBe(true)
+    expect(pickerVisible({ modelRef: "b/2", registryModel: entry() })).toBe(true)
+  })
+
+  test("a model absent from a non-empty chain is still visible", () => {
+    // The live single-entry chain must not shrink 692 models to one.
+    const chain = ["a/1", "b/2#high"]
+
+    expect(pickerVisible({ modelRef: "a/1", registryModel: entry() })).toBe(true)
+    expect(pickerVisible({ modelRef: "b/2", registryModel: entry() })).toBe(true)
+    expect(pickerVisible({ modelRef: "c/3", registryModel: entry() })).toBe(true)
+    expect(chainIndexOf(chain, ref("c", "3"))).toBe(-1)
+  })
+
+  test("hidden models disappear, from the registry and from the legacy set", () => {
+    expect(pickerVisible({ modelRef: "a/1", registryModel: entry(false) })).toBe(false)
+    expect(
+      pickerVisible({ modelRef: "a/1", hiddenSet: new Set([normalizeModelRef("a/1")]), legacyVisible: true }),
+    ).toBe(false)
+    // The registry wins over a stale legacy answer.
+    expect(pickerVisible({ modelRef: "a/1", registryModel: entry(false), legacyVisible: true })).toBe(false)
+  })
+
+  test("hidden is the only exclusion besides provider connectivity", () => {
+    expect(pickerVisible({ modelRef: "a/1", registryModel: entry(false) })).toBe(false)
+    expect(pickerVisible({ modelRef: "a/1", legacyVisible: false })).toBe(false)
+    // No chain can turn a visible model off, and none can turn a hidden one on.
+    expect(pickerVisible({ modelRef: "z/9", registryModel: entry(true) })).toBe(true)
+    expect(pickerVisible({ modelRef: "z/9", registryModel: entry(false) })).toBe(false)
+  })
+
+  test("a model of an unconnected provider is never offered", () => {
+    expect(pickerVisible({ modelRef: "a/1", registryModel: entry(), providerConnected: false })).toBe(false)
+    expect(pickerVisible({ modelRef: "a/1", legacyVisible: true, providerConnected: false })).toBe(false)
+  })
+})
+
+describe("picker ordering", () => {
+  const order = (name: string, favorite: boolean, chainIndex = -1): PickerOrder => ({
+    name,
+    ref: `x/${name}`,
+    favorite,
+    chainIndex,
+  })
+
+  test("favorites lead, then the chain order, then the name", () => {
+    const items = [order("Zed", false, 2), order("Beta", true, -1), order("Alpha", false, 0), order("Gamma", false, -1)]
+
+    expect([...items].sort(comparePickerModels).map((item) => item.name)).toEqual([
+      "Beta",
+      "Alpha",
+      "Zed",
+      "Gamma",
+    ])
+  })
+
+  test("models outside the chain follow every chained model, whatever their name", () => {
+    const items = [order("aaa", false, -1), order("zzz", false, 0)]
+
+    expect([...items].sort(comparePickerModels).map((item) => item.name)).toEqual(["zzz", "aaa"])
+  })
+
+  test("an unchained list sorts by name only", () => {
+    const items = [order("Cee", false, -1), order("Aye", false, -1), order("Bee", false, -1)]
+
+    expect([...items].sort(comparePickerModels).map((item) => item.name)).toEqual(["Aye", "Bee", "Cee"])
+  })
+
+  test("a name tie keeps a stable order by ref", () => {
+    const items = [
+      { name: "same", ref: "b/2", favorite: false, chainIndex: -1 },
+      { name: "same", ref: "a/1", favorite: false, chainIndex: -1 },
+    ]
+
+    expect([...items].sort(comparePickerModels).map((item) => item.ref)).toEqual(["a/1", "b/2"])
+  })
+
+  test("favoriteRefs normalizes the registry's favorites", () => {
+    const models = [
+      { providerID: "Anthropic", id: "Claude.Sonnet-4", favorite: true },
+      { providerID: "openai", id: "gpt-5.6", favorite: false },
+    ]
+
+    expect([...favoriteRefs(models)]).toEqual(["anthropic/claude-sonnet-4"])
+    expect(favoriteRefs([])).toEqual(new Set())
+  })
+})
diff -ruN a/packages/app/src/providers/models/policy.ts b/packages/app/src/providers/models/policy.ts
--- a/packages/app/src/providers/models/policy.ts	1970-01-01 02:00:00.000000000 +0200
+++ b/packages/app/src/providers/models/policy.ts	2026-11-15 16:29:49.640671251 +0300
@@ -0,0 +1,110 @@
+import type { RegistryModel } from "@/settings/models/api"
+
+/**
+ * The chat picker's policy, as pure functions.
+ *
+ * When `GET /api/models/registry` answers, the picker follows it: a model is
+ * offered when the config does not hide it and its provider is connected. When
+ * the registry is unavailable, an older server keeps the store's own visibility
+ * rule, so nothing is lost by upgrading.
+ *
+ * Visibility and ordering are deliberately separate concerns. `models.hidden`
+ * is the *only* visibility control besides provider connectivity; a fallback
+ * chain never hides anything. `models.chain` / `models.chains.<agent>` are a
+ * routing preference, so they only decide where a model sits in the list.
+ */
+
+export type RegistryPickerModel = Pick<RegistryModel, "providerID" | "id" | "name" | "visible" | "favorite">
+
+/** `provider/id` with any `#variant` suffix dropped, lowercased and `.` folded to `-`. */
+export function normalizeModelRef(reference: string): string {
+  const [base = ""] = reference.split("#")
+
+  return base.trim().toLowerCase().replaceAll(".", "-")
+}
+
+export const modelReference = (model: { providerID: string; id: string }) => `${model.providerID}/${model.id}`
+
+/**
+ * The chain that *orders* the picker for `agent`: its own when `chains` lists
+ * one, else the global chain. Ordering cannot exclude a model, so an absent or
+ * empty chain simply means "nothing sorts ahead of the rest".
+ */
+export function effectiveAgentChain(
+  chains: Readonly<Record<string, readonly string[]>> | undefined,
+  agent: string | undefined,
+  chain: readonly string[],
+): string[] {
+  const own = agent === undefined || chains === undefined ? undefined : chains[agent]
+
+  return [...(own ?? chain)]
+}
+
+/** Where `reference` sits in `chain`, or `-1` when absent. A `#variant` entry matches its base ref. */
+export function chainIndexOf(chain: readonly string[], reference: string): number {
+  const key = normalizeModelRef(reference)
+
+  return chain.findIndex((entry) => normalizeModelRef(entry) === key)
+}
+
+/**
+ * The picker's visibility inputs.
+ *
+ * There is intentionally no chain field here: a fallback chain orders rows, it
+ * must never remove one, so it cannot be expressed as a visibility question.
+ */
+export type PickerVisibility = {
+  /** The model's `provider/id`. */
+  modelRef: string
+  /** Its registry entry, when the registry answered and lists it. */
+  registryModel?: Pick<RegistryPickerModel, "visible">
+  /** Refs the config hides, normalized: the fallback for a model the registry does not list. */
+  hiddenSet?: ReadonlySet<string>
+  /** `false` excludes the model outright: the picker only offers connected providers. */
+  providerConnected?: boolean
+  /** The legacy store's answer, read only when the registry does not list the model. */
+  legacyVisible?: boolean
+}
+
+/**
+ * The picker's visibility rule: `!hidden && providerConnected`.
+ *
+ * The registry's `visible` field is already the inverse of `models.hidden`, so a
+ * registry model needs no `hiddenSet`. Without a registry the legacy store's
+ * answer stands, which is exactly the old picker. A model absent from a
+ * non-empty chain is still visible; chains only reorder.
+ */
+export function pickerVisible(input: PickerVisibility): boolean {
+  if (input.providerConnected === false) return false
+  if (input.hiddenSet?.has(normalizeModelRef(input.modelRef))) return false
+
+  if (input.registryModel) return input.registryModel.visible
+
+  return input.legacyVisible !== false
+}
+
+export type PickerOrder = { name: string; ref: string; favorite: boolean; chainIndex: number }
+
+/**
+ * Favorites first, then the agent's chain order, then the name. A model outside
+ * the chain sorts after every chained model; the ref breaks a name tie so two
+ * openings of the dialog list the same models in the same order.
+ */
+export function comparePickerModels(a: PickerOrder, b: PickerOrder): number {
+  if (a.favorite !== b.favorite) return a.favorite ? -1 : 1
+  const left = a.chainIndex < 0 ? Number.MAX_SAFE_INTEGER : a.chainIndex
+  const right = b.chainIndex < 0 ? Number.MAX_SAFE_INTEGER : b.chainIndex
+
+  if (left !== right) return left - right
+
+  return a.name.localeCompare(b.name) || a.ref.localeCompare(b.ref)
+}
+
+/** The normalized refs of every favorite the registry reports. */
+export function favoriteRefs(
+  models: readonly Pick<RegistryPickerModel, "providerID" | "id" | "favorite">[],
+): Set<string> {
+  return new Set(
+    models.filter((model) => model.favorite).map((model) => normalizeModelRef(modelReference(model))),
+  )
+}
